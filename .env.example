# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from: https://app.supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Paystack Configuration (Optional)
# Get this from: https://dashboard.paystack.com → Settings → API Keys
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
